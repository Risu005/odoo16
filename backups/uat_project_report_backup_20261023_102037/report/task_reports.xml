<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Report PDF -->
    <record id="task_report_pdf" model="ir.actions.report">
        <field name="name">Daily Report</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_report.task_report_template</field>
        <field name="report_file">project_report.task_report_template</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Enhanced Task Report Template -->
    <template id="task_report_template">
        <t t-call="web.html_container">
            <t t-set="processed_projects" t-value="[]"/>
            <t t-set="today" t-value="datetime.datetime.now()"/>

            <t t-foreach="docs" t-as="task">
                <t t-set="current_project_id" t-value="task.project_id.id if task.project_id else 0"/>

                <t t-if="current_project_id not in processed_projects">
                    <t t-set="processed_projects" t-value="processed_projects + [current_project_id]"/>
                    <t t-set="project_tasks" t-value="docs.filtered(lambda t: (t.project_id.id if t.project_id else 0) == current_project_id)"/>
                    <t t-set="first_task" t-value="project_tasks[0]"/>

                    <!-- Project-level reporting dates -->
                    <t t-set="project_start_dates" t-value="project_tasks.filtered(lambda t: t.report_start_date).mapped('report_start_date')"/>
                    <t t-set="project_start_date" t-value="project_start_dates and min(project_start_dates) or False"/>
                    <t t-set="project_deadlines" t-value="project_tasks.filtered(lambda t: t.date_deadline).mapped('date_deadline')"/>
                    <t t-set="project_expected_close_date" t-value="project_deadlines and max(project_deadlines) or False"/>

                    <t t-call="web.external_layout">
                        <div class="page" style="font-size: 12px;">
                            <div class="oe_structure"/>

                            <!-- Report Title -->
                            <h2 style="text-align: center; margin-bottom: 20px; font-size: 30px; font-weight: bold;">
                                Daily Report
                            </h2>

                            <!-- Header -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <table class="table table-sm table-borderless" style="border: 1px solid #dee2e6; font-size: 11px;">
                                        <thead>
                                            <tr style="background-color: #f8f9fa;">
                                                <th style="border: 1px solid #dee2e6; padding: 6px; width: 22%;">DESCRIPTION</th>
                                                <th style="border: 1px solid #dee2e6; padding: 6px; width: 78%;">DETAILS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Project Info -->
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Customer Contact:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-esc="first_task.partner_id.name"/>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Project Title:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-esc="first_task.project_id.name if first_task.project_id else 'No Project'"/>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Project ID:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-esc="first_task.get_project_id_code()"/>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Project Manager:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-esc="first_task.project_id.user_id.name if first_task.project_id and first_task.project_id.user_id else 'Not assigned'"/>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Engineer(s) Assigned:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-set="all_engineers" t-value="', '.join(set(sum([t.user_ids.mapped('name') for t in project_tasks], [])))"/>
                                                    <t t-if="all_engineers">
                                                        <t t-esc="all_engineers"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">No engineers assigned</span>
                                                    </t>
                                                </td>
                                            </tr>

                                            <!-- Dates -->
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Start Date:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-if="project_start_date">
                                                        <t t-esc="project_start_date.strftime('%d %B %Y')"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">Not set</span>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold;">Expected Close Date:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-if="project_expected_close_date">
                                                        <t t-esc="project_expected_close_date.strftime('%d %B %Y')"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">Not set</span>
                                                    </t>
                                                </td>
                                            </tr>

                                            <!-- Task Done for the Day -->
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold; vertical-align: top;">Task Done for the Day:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-foreach="project_tasks" t-as="main_task">
                                                        <t t-set="done_subtasks" t-value="main_task.child_ids.filtered(lambda s: s.kanban_state == 'done')"/>
                                                        <t t-if="main_task.kanban_state == 'done' or done_subtasks">
                                                            <div style="margin-bottom: 10px;">
                                                                <strong><t t-esc="main_task.name"/></strong>
                                                                <span style="font-size: 11px; color: #6c757d;">
                                                                    <t t-if="main_task.report_start_date">
                                                                        (Start Date: <t t-esc="main_task.report_start_date.strftime('%d %b %Y')"/>)
                                                                    </t>
                                                                    <t t-if="main_task.date_end">
                                                                        <t t-if="main_task.report_start_date"> | </t>
                                                                        (Completed On: <t t-esc="main_task.date_end.strftime('%d %b %Y')"/>)
                                                                    </t>
                                                                </span>

                                                                <t t-if="done_subtasks">
                                                                    <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse; margin-top: 5px;">
                                                                        <tr style="background-color: #f8f9fa;">
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Subtask</th>
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Start Date</th>
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Status</th>
                                                                        </tr>
                                                                        <t t-foreach="done_subtasks" t-as="sub">
                                                                            <tr>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">
                                                                                    <t t-esc="sub.name"/>
                                                                                </td>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">
                                                                                    <t t-esc="sub.report_start_date and sub.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                                                                                </td>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">Completed</td>
                                                                            </tr>
                                                                        </t>
                                                                    </table>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </td>
                                            </tr>

                                            <!-- Next Action Items -->
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold; vertical-align: top;">Next Action Items:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-foreach="project_tasks" t-as="main_task">
                                                        <t t-set="pending_subtasks" t-value="main_task.child_ids.filtered(lambda s: s.kanban_state != 'done')"/>
                                                        <t t-if="main_task.kanban_state != 'done' or pending_subtasks">
                                                            <div style="margin-bottom: 10px;">
                                                                <strong><t t-esc="main_task.name"/></strong>
                                                                <t t-if="main_task.report_start_date">
                                                                    <span style="font-size: 11px; color: #6c757d;">
                                                                        (Start Date: <t t-esc="main_task.report_start_date.strftime('%d %b %Y')"/>)
                                                                    </span>
                                                                </t>

                                                                <t t-if="pending_subtasks">
                                                                    <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse; margin-top: 5px;">
                                                                        <tr style="background-color: #f8f9fa;">
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Subtask</th>
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Start Date</th>
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Deadline</th>
                                                                            <th style="border: 1px solid #dee2e6; padding: 4px; font-size: 10px;">Status</th>
                                                                        </tr>
                                                                        <t t-foreach="pending_subtasks" t-as="sub">
                                                                            <tr>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;"><t t-esc="sub.name"/></td>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">
                                                                                    <t t-esc="sub.report_start_date and sub.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                                                                                </td>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">
                                                                                    <t t-esc="sub.date_deadline and sub.date_deadline.strftime('%d %b %Y') or 'No deadline'"/>
                                                                                </td>
                                                                                <td style="border: 1px solid #dee2e6; padding: 4px;">
                                                                                    <t t-if="sub.kanban_state == 'blocked'">Blocked</t>
                                                                                    <t t-elif="sub.kanban_state == 'done'">Completed</t>
                                                                                    <t t-else="">In Progress</t>
                                                                                </td>
                                                                            </tr>
                                                                        </t>
                                                                    </table>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </td>
                                            </tr>

                                            <!-- Customer Actions -->
                                            <tr>
                                                <td style="border: 1px solid #dee2e6; padding: 6px; font-weight: bold; vertical-align: top;">Action Required from Customer:</td>
                                                <td style="border: 1px solid #dee2e6; padding: 6px;">
                                                    <t t-set="has_customer_actions" t-value="False"/>
                                                    <t t-foreach="project_tasks" t-as="ptask">
                                                        <t t-set="customer_action" t-value="ptask.get_customer_actions_required()"/>
                                                        <t t-if="customer_action and customer_action != 'No specific action required at this time'">
                                                            <t t-set="has_customer_actions" t-value="True"/>
                                                            • <t t-esc="customer_action"/><br/>
                                                        </t>
                                                    </t>
                                                    <t t-if="not has_customer_actions">
                                                        <span class="text-muted">No specific action required at this time</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="row" style="margin-top: auto;">
                                <div class="col-12 text-center">
                                    <p class="text-muted" style="font-size: 9px; margin-bottom: 0;">
                                        Report generated on <t t-esc="today.strftime('%d %B %Y at %I:%M %p')"/>
                                    </p>
                                </div>
                            </div>
                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- Reusable Subtemplate for Rendering Task + Subtasks (without deadline) -->
    <template id="render_task_table">
        <t t-if="main_task.child_ids">
            <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse;">
                <tr style="background-color: #f8f9fa;">
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 35%; font-size: 10px;">Task</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 35%; font-size: 10px;">Start Date</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 30%; font-size: 10px;">Status</th>
                </tr>
                <tr>
                    <td t-att-rowspan="len(main_task.child_ids) + 1" style="border: 1px solid #dee2e6; padding: 4px; vertical-align: top;">
                        <strong><t t-esc="main_task.name"/>:</strong><br/>
                    </td>
                    <t t-if="main_task.child_ids">
                        <t t-set="first_subtask" t-value="main_task.child_ids[0]"/>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="first_subtask.report_start_date and first_subtask.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-if="first_subtask.kanban_state == 'done'">Completed</t>
                            <t t-elif="first_subtask.kanban_state == 'blocked'">Blocked</t>
                            <t t-else="">In Progress</t>
                        </td>
                    </t>
                </tr>
                <t t-foreach="main_task.child_ids[1:]" t-as="subtask">
                    <tr>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="subtask.report_start_date and subtask.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-if="subtask.kanban_state == 'done'">Completed</t>
                            <t t-elif="subtask.kanban_state == 'blocked'">Blocked</t>
                            <t t-else="">In Progress</t>
                        </td>
                    </tr>
                </t>
            </table>
        </t>
        <t t-else="">
            <div>
                <strong><t t-esc="main_task.name"/></strong>
                <t t-if="main_task.report_start_date">
                    <span style="font-size: 10px; color: #6c757d;">
                        (Start Date: <t t-esc="main_task.report_start_date.strftime('%d %b %Y')"/>)
                    </span>
                </t>
            </div>
        </t>
    </template>

    <!-- New Subtemplate for Next Action Items (with deadline) -->
    <template id="render_task_table_with_deadline">
        <t t-if="main_task.child_ids">
            <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse;">
                <tr style="background-color: #f8f9fa;">
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 20%; font-size: 10px;">Task</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 30%; font-size: 10px;">Subtask</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 20%; font-size: 10px;">Start Date</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 15%; font-size: 10px;">Deadline</th>
                    <th style="border: 1px solid #dee2e6; padding: 4px; width: 15%; font-size: 10px;">Status</th>
                </tr>
                <tr>
                    <td t-att-rowspan="len(main_task.child_ids) + 1" style="border: 1px solid #dee2e6; padding: 4px; vertical-align: top;">
                        <strong><t t-esc="main_task.name"/>:</strong><br/>
                    </td>
                    <t t-if="main_task.child_ids">
                        <t t-set="first_subtask" t-value="main_task.child_ids[0]"/>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="first_subtask.name"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="first_subtask.report_start_date and first_subtask.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="first_subtask.date_deadline and first_subtask.date_deadline.strftime('%d %b %Y') or 'No deadline'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-if="first_subtask.kanban_state == 'done'">Completed</t>
                            <t t-elif="first_subtask.kanban_state == 'blocked'">Blocked</t>
                            <t t-else="">In Progress</t>
                        </td>
                    </t>
                </tr>
                <t t-foreach="main_task.child_ids[1:]" t-as="subtask">
                    <tr>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="subtask.name"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="subtask.report_start_date and subtask.report_start_date.strftime('%d %b %Y') or 'Not set'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-esc="subtask.date_deadline and subtask.date_deadline.strftime('%d %b %Y') or 'No deadline'"/>
                        </td>
                        <td style="border: 1px solid #dee2e6; padding: 4px;">
                            <t t-if="subtask.kanban_state == 'done'">Completed</t>
                            <t t-elif="subtask.kanban_state == 'blocked'">Blocked</t>
                            <t t-else="">In Progress</t>
                        </td>
                    </tr>
                </t>
            </table>
        </t>
        <t t-else="">
            <div>
                <strong><t t-esc="main_task.name"/></strong>
                <span style="font-size: 10px; color: black;">
                    <t t-if="main_task.report_start_date">
                        (Start: <t t-esc="main_task.report_start_date.strftime('%d %b %Y')"/> |
                    </t>
                    Deadline: <t t-esc="main_task.date_deadline and main_task.date_deadline.strftime('%d %b %Y') or 'No deadline'"/>)
                </span>
            </div>
        </t>
    </template>
</odoo>