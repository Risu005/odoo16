<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_send_task_report_server" model="ir.actions.server">
        <field name="name">Email Task Report</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">form</field>
        <field name="code">
action = records.action_send_task_report_email()
        </field>
    </record>

    <!-- Add report actions to project form view -->
    <record id="view_project_form_inherit_report" model="ir.ui.view">
        <field name="name">project.project.form.inherit.report</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Add the email report button to project header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_project_report_email"
                        string="Email Project Report"
                        type="object"
                        class="btn-primary"
                        icon="fa-envelope"
                        attrs="{'invisible': [('partner_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <!-- Task form view - add report start date and status -->
    <record id="view_task_form_inherit_report_start_date" model="ir.ui.view">
        <field name="name">project.task.form.inherit.report.start.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="report_start_date"/>
                <field name="status"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/tree/field[@name='date_deadline']" position="before">
                <field name="report_start_date" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/tree/field[@name='date_deadline']" position="after">
                <field name="status" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Task list view - add quick action buttons -->
    <record id="view_task_tree_inherit_report" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.report</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <!-- Add report_start_date, status and date_last_report columns to tree view -->
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="report_start_date" optional="show"/>
                <field name="status" optional="show"/>
                <field name="date_last_report" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add menu item for reports -->
    <record id="menu_project_task_reports" model="ir.ui.menu">
        <field name="name">Task Reports</field>
        <field name="parent_id" ref="project.menu_project_report"/>
        <field name="sequence">10</field>
    </record>

    <!-- Add action for generating task reports -->
    <record id="action_task_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Task Reports</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task report!
            </p>
            <p>
                Generate and send daily task reports to keep your customers informed about project progress.
            </p>
        </field>
    </record>

    <!-- Add server actions for bulk operations -->
    <record id="server_action_send_task_reports" model="ir.actions.server">
        <field name="name">Send Task Reports</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    for record in records:
        if record.project_id.partner_id and record.project_id.partner_id.email:
            record.action_send_task_report_email()
        else:
            raise UserError("Task %s: No customer email found for project %s" %
                            (record.name, record.project_id.name))
        </field>
    </record>

    <record id="server_action_print_task_reports" model="ir.actions.server">
        <field name="name">Print Task Reports</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.write({'date_last_report': fields.Date.today()})
    action = env.ref('project_report.task_report_pdf').report_action(records)
        </field>
    </record>

    <!-- Add smart button to project form to show task reports -->
    <record id="view_project_form_smart_button_reports" model="ir.ui.view">
        <field name="name">project.project.form.smart.button.reports</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="action"
                        name="%(action_task_report_wizard)d"
                        context="{'search_default_project_id': active_id}"
                        icon="fa-file-text-o">
                    <field string="Task Reports" name="task_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>