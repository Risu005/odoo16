<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Task Daily Report (Simplified) -->
        <record id="email_template_task_report" model="mail.template">
            <field name="name">Task Daily Report</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="subject">Task Report - {{ object.name }} ({{ ctx['date'].strftime('%Y-%m-%d') }})</field>
            <field name="email_to">{{ object.project_id.partner_id.email or '' }}</field>
            <field name="email_cc">{{ object.project_id.user_id.email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <h2>Task Daily Report</h2>
                    <p><strong>Project:</strong> <t t-esc="object.project_id.name"/></p>
                    <p><strong>Task:</strong> <t t-esc="object.name"/></p>
                    <p><strong>Customer:</strong> <t t-esc="object.project_id.partner_id.name or 'N/A'"/></p>
                    <p><strong>Assigned To:</strong>
                        <t t-if="object.user_ids">
                            <t t-foreach="object.user_ids" t-as="user">
                                <t t-esc="user.name"/><t t-if="not loop.last">, </t>
                            </t>
                        </t>
                        <t t-else="">Not assigned</t>
                    </p>
                    <p><strong>Stage:</strong> <t t-esc="object.stage_id.name or 'No stage'"/></p>
                    <t t-if="object.date_deadline">
                        <p><strong>Deadline:</strong> <t t-esc="object.date_deadline.strftime('%Y-%m-%d')"/></p>
                    </t>

                    <hr/>
                    <h3>Progress</h3>
                    <t t-if="object.description">
                        <p><t t-raw="object.description"/></p>
                    </t>
                    <t t-else="">
                        <p><em>No description provided.</em></p>
                    </t>

                    <hr/>
                    <h3>Next Actions</h3>
                    <t t-if="object.stage_id and object.stage_id.fold">
                        <p>✅ Task completed. Awaiting customer feedback.</p>
                    </t>
                    <t t-elif="object.stage_id and ('progress' in object.stage_id.name.lower() or 'doing' in object.stage_id.name.lower())">
                        <p>🔄 Work in progress. Continue task execution.</p>
                    </t>
                    <t t-else="">
                        <p>🚀 Task pending. Please start work.</p>
                    </t>

                    <hr/>
                    <p style="font-size:12px; color:gray;">
                        This is an automated task update. Contact <t t-esc="object.project_id.user_id.name"/> for details.
                    </p>
                </div>
            </field>
        </record>

        <!-- Project Daily Report (Simplified) -->
        <record id="email_template_project_daily_report" model="mail.template">
            <field name="name">Project Daily Report</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="subject">Project Report - {{ object.name }} ({{ ctx['date'].strftime('%Y-%m-%d') }})</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="email_cc">{{ object.user_id.email or '' }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <h2>Project Daily Report</h2>
                    <p><strong>Project:</strong> <t t-esc="object.name"/></p>
                    <p><strong>Customer:</strong> <t t-esc="object.partner_id.name or 'N/A'"/></p>
                    <p><strong>Manager:</strong> <t t-esc="object.user_id.name or 'N/A'"/></p>
                    <p><strong>Total Tasks:</strong> <t t-esc="len(object.task_ids) if object.task_ids else 0"/></p>

                    <t t-set="completed_tasks" t-value="len([t for t in object.task_ids if t.stage_id and t.stage_id.fold]) if object.task_ids else 0"/>
                    <t t-set="total_tasks" t-value="len(object.task_ids) if object.task_ids else 0"/>
                    <p><strong>Completed:</strong> <t t-esc="completed_tasks"/> / <t t-esc="total_tasks"/></p>

                    <hr/>
                    <h3>Today's Updates</h3>
                    <t t-set="today_date" t-value="datetime.datetime.now().date()"/>
                    <t t-set="today_tasks" t-value="[t for t in object.task_ids if t.write_date and t.write_date.date() == today_date] if object.task_ids else []"/>
                    <t t-if="today_tasks">
                        <ul>
                            <t t-foreach="today_tasks[:5]" t-as="task">
                                <li><t t-esc="task.name"/> - <t t-esc="task.stage_id.name or 'No Stage'"/></li>
                            </t>
                            <t t-if="len(today_tasks) > 5">
                                <li>... and <t t-esc="len(today_tasks) - 5"/> more tasks updated today</li>
                            </t>
                        </ul>
                    </t>
                    <t t-else="">
                        <p><em>No tasks updated today.</em></p>
                    </t>

                    <hr/>
                    <p style="font-size:12px; color:gray;">
                        This is an automated project update. Contact <t t-esc="object.user_id.name"/> for details.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
